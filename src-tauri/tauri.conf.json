{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ByteCaptions",
	"version": "0.9.0",
	"identifier": "com.byteofmelon.bytecaptions",
	"build": {
		"frontendDist": "../dist/bytecaptions/browser",
		"devUrl": "http://localhost:4200",
		"beforeDevCommand": "npm run fetch:ffmpeg && npm run fetch:vulkan && npm run start",
		"beforeBuildCommand": "npm run fetch:ffmpeg && npm run fetch:vulkan && npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "ByteCaptions",
				"width": 1440,
				"height": 900,
				"minWidth": 1280,
				"minHeight": 720,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "Michael Webb",
		"copyright": "Copyright © 2026 Michael Webb/Byte of Melon. Licensed under the GNU GPL, version 3 or later.",
		"homepage": "https://github.com/ByteOfMelon/ByteCaptions",
		"category": "Video",
		"shortDescription": "Subtitle editor",
		"longDescription": "The open-source video-editing-style subtitle editor",
		"fileAssociations": [
			{
				"ext": ["bcproj"],
				"name": "ByteCaptions project",
				"description": "ByteCaptions project",
				"role": "Editor",
				"mimeType": "application/x-bytecaptions-project"
			}
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"externalBin": ["binaries/ffmpeg"],
		"resources": {
			"../LICENSE": "licenses/BYTECAPTIONS-LICENSE.txt",
			"licenses/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
			"licenses/SPEAKER-MODELS.txt": "licenses/SPEAKER-MODELS.txt"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNkQwMzY3MDI1RUMxREIKUldUYndWNENad050V2dyaEhSUE44NXVhTFlWTlZrbnFDVm5iMTQvajJmb0ovVitXM3hDYXRGaVoK",
			"endpoints": [
				"https://github.com/ByteOfMelon/ByteCaptions/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
