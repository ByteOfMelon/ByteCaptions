{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ByteCaptions",
	"version": "0.9.0",
	"identifier": "com.byteofmelon.bytecaptions",
	"build": {
		"frontendDist": "../dist/bytecaptions/browser",
		"devUrl": "http://localhost:4200",
		"beforeDevCommand": "npm run fetch:ffmpeg && npm run fetch:vulkan && npm run start",
		"beforeBuildCommand": "npm run fetch:ffmpeg && npm run fetch:vulkan && npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "ByteCaptions",
				"width": 1440,
				"height": 900,
				"minWidth": 1280,
				"minHeight": 720,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"externalBin": ["binaries/ffmpeg"],
		"resources": {
			"licenses/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
			"licenses/SPEAKER-MODELS.txt": "licenses/SPEAKER-MODELS.txt"
		}
	}
}
